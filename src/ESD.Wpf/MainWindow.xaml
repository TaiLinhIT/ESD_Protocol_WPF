<Window x:Class="ESD.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ESD Protocol Gateway" Width="1200" Height="760" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="120"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,12"><TextBlock Text="ESD Protocol Gateway" FontSize="25" FontWeight="Bold"/><TextBlock DockPanel.Dock="Right" Text="ESD-FP-V1.0" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel><UniformGrid Grid.Row="1" Columns="4"><Border Background="{StaticResource Panel}" Margin="5" Padding="12"><StackPanel><TextBlock Text="CONNECTION" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Conn" Text="Disconnected" FontSize="20"/></StackPanel></Border><Border Background="{StaticResource Panel}" Margin="5" Padding="12"><StackPanel><TextBlock Text="VALID" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Valid" Text="0" FontSize="20"/></StackPanel></Border><Border Background="{StaticResource Panel}" Margin="5" Padding="12"><StackPanel><TextBlock Text="BAD" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Bad" Text="0" FontSize="20"/></StackPanel></Border><Border Background="{StaticResource Panel}" Margin="5" Padding="12"><StackPanel><TextBlock Text="LAST EVENT" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Last" Text="None" FontSize="18"/></StackPanel></Border></UniformGrid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource Panel}" Margin="5" Padding="12"><ScrollViewer><StackPanel><TextBlock Text="Connection" FontSize="18" FontWeight="Bold"/><TextBlock Text="COM Port" Foreground="{StaticResource Muted}"/><ComboBox x:Name="Ports"/><TextBlock Text="Baud" Foreground="{StaticResource Muted}"/><ComboBox x:Name="Bauds"/><StackPanel Orientation="Horizontal"><Button Content="Refresh" Click="Refresh"/><Button Content="Connect" Click="Connect"/><Button Content="Disconnect" Click="Disconnect"/></StackPanel><Separator Margin="0,10"/><TextBlock Text="Device ID" Foreground="{StaticResource Muted}"/><TextBox x:Name="Dev" Text="123"/><TextBlock Text="Worker ID" Foreground="{StaticResource Muted}"/><TextBox x:Name="Worker" Text="A12345"/><TextBlock Text="Secret Key (hex)" Foreground="{StaticResource Muted}"/><TextBox x:Name="Key" Text="00112233445566778899AABBCCDDEEFF"/><Button Content="Send WORKER_SCAN" Click="WorkerScan"/><Button Content="Send HEARTBEAT" Click="Heartbeat"/><TextBlock Text="Raw TX Hex" Foreground="{StaticResource Muted}"/><TextBox x:Name="Raw" Height="90" AcceptsReturn="True" TextWrapping="Wrap"/><Button Content="Send Raw" Click="SendRaw"/></StackPanel></ScrollViewer></Border><Border Grid.Column="1" Background="{StaticResource Panel}" Margin="5" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Communication Log" FontSize="18" FontWeight="Bold"/><ListBox x:Name="Log" Background="Transparent" Foreground="{StaticResource Text}" BorderThickness="0"/></DockPanel></Border></Grid></Grid></Window>
